# Copy to .env on the server and fill in. Never commit .env.

# Public DNS (A records → Elastic IP)
MEETJOE_SITE_DOMAIN=meetjoe.joesolutions.ph
MEETJOE_API_DOMAIN=api.meetjoe.joesolutions.ph
ACME_EMAIL=ops@joesolutions.ph

# Elastic IP of this instance (used by LiveKit node_ip)
PUBLIC_IP=x.x.x.x

# Postgres
POSTGRES_USER=meetjoe
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=meetjoe

# MinIO
MINIO_ROOT_USER=meetjoe
MINIO_ROOT_PASSWORD=change-me-long-random
MINIO_BUCKET=meetjoe-files

# LiveKit (API key name + secret; secret should be long)
LIVEKIT_API_KEY=meetjoe
LIVEKIT_API_SECRET=change-me-32chars-minimum-secret-ok

# Optional: set by GitHub Actions deploy to a GHCR image tag
# MEETJOE_API_IMAGE=ghcr.io/joe-solutions/meetjoe-api:sha-xxxxxxxxxxxx
