<Project Sdk="Microsoft.NET.Sdk">
  <!-- Thin Avalonia Android host. UI lives in MeetJoe.App (M0 spike). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.joesolutions.meetjoe</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RootNamespace>MeetJoe.Android</RootNamespace>
    <AssemblyName>MeetJoe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeetJoe.App\MeetJoe.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
</Project>
