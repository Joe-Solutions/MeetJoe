{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "KeysPath": ".data/keys",
    "RequireHttps": true,
    "RateLimitPerMinute": 20
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Storage": {
    "Bucket": "meetjoe-files"
  },
  "DesktopUpdates": {
    "RootPath": "releases/desktop",
    "UrlPath": "/updates/desktop",
    "Channel": "stable"
  },
  "PublicUrls": {
    "WebBaseUrl": "https://api.meetjoe.joesolutions.ph",
    "DesktopScheme": "meetjoe"
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@joesolutions.ph",
    "FromName": "MeetJoe"
  }
}
