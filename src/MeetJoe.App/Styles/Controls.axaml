<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:MeetJoe.App.Controls">

  <!-- ===== Base ===== -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
  </Style>

  <!-- ===== Text ===== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.callstatus">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.callstatus.missed">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="TextBlock.callstatus.duration">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="TextBlock.callstatus.rejected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- Single-line composer for meeting / call chat (aligned with Send). -->
  <Style Selector="TextBox.roomcomposer">
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="MaxHeight" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.roomcomposer /template/ TextBlock#PART_Watermark">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- A text box with no chrome of its own, for use inside the composer. -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="4,4,6,6" />
  </Style>
  <Style Selector="Border.composer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="#0F2A40" />
  </Style>
  <!-- Drag-drop highlight for chat composers (DM / meeting / call). -->
  <Style Selector="Border.composer.filedrop">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="Border.roomcomposer-drop.filedrop">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <!-- Full conversation drop surface (messages + composer). -->
  <Style Selector="Border.chatdrop">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Border.chatdrop.filedrop">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>

  <Style Selector="Border.composer-toolbar">
    <Setter Property="Padding" Value="6,4,6,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.emojipicker">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="8,4,8,6" />
  </Style>

  <Style Selector="Button.composertool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.composertool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.composertool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <Style Selector="Button.emoji">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.emoji:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
  </Style>
  <Style Selector="Button.emoji:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>

  <Style Selector="Button.send">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
  </Style>
  <Style Selector="Button.send:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
  </Style>
  <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Primary: the one main action in a view -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <!-- Secondary: outlined, for the alternative to a primary action -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- Danger: leaving or ending something -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EE7465" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#CC4E3F" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Ghost: quiet text or icon action -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#4F6577" />
  </Style>
  <Style Selector="Button.ghost.tint">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.ghost.tint:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
  </Style>
  <Style Selector="Button.ghost.square">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Link: inline text action -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPressed}" />
  </Style>

  <!-- Row: a full-width entry in a list pane -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.row.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- Rail: a destination on the left navigation rail -->
  <Style Selector="Button.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Width" Value="68" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.rail:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.rail.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>


  <!-- ===== Surfaces ===== -->
  <!-- The list pane beside the rail -->
  <Style Selector="Border.listpane">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <!-- The optional context panel on the right -->
  <Style Selector="Border.contextpane">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Width" Value="280" />
  </Style>
  <!-- The header strip above a main stage -->
  <Style Selector="Border.stageheader">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,0,16,0" />
    <Setter Property="Height" Value="64" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
  </Style>

  <!-- ===== Motion ===== -->
  <!-- Message insert: fade in while rising a few pixels -->
  <Style Selector="DockPanel.message">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- After the base rule: later styles win. -->
  <Style Selector="DockPanel.message.first">
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <Style Selector="DockPanel.message.continuation">
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="DockPanel.message.mine">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="StackPanel.messagebody.mine">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="StackPanel.messagemeta.mine">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="DockPanel.messagechrome">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="DockPanel.messagechrome.mine">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="DockPanel.message">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <!--
    Emoji + reply dock beside the bubble (in layout). That keeps them inside the message
    hit-box so moving the pointer onto the icons does not clear :pointerover.
  -->
  <Style Selector="StackPanel.message-sideactions">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="DockPanel.messagechrome.mine > StackPanel.message-sideactions">
    <Setter Property="DockPanel.Dock" Value="Left" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="DockPanel.message:pointerover StackPanel.message-sideactions">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="DockPanel.message.picking StackPanel.message-sideactions">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>

  <Style Selector="Border.message-reactionpicker">
    <Setter Property="Background" Value="#E6121E2E" />
    <Setter Property="BorderBrush" Value="#3D6A94" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #66000000" />
  </Style>
  <Style Selector="DockPanel.messagechrome.mine Border.message-reactionpicker">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="Button.hoverreact">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hoverreact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="Button.hoverreact:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
  </Style>

  <Style Selector="Button.hovericon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hovericon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.hovericon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
  </Style>
  <Style Selector="Button.hovericon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="Button.hovericon.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>

  <Style Selector="ItemsControl.messagereactions.mine">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <!-- Reaction chips under messages -->
  <Style Selector="Button.reactionchip">
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.reactionchip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" />
    <Setter Property="BorderBrush" Value="#2C5273" />
  </Style>
  <Style Selector="Button.reactionchip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
  </Style>
  <Style Selector="Button.reactionchip.mine">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.reactionchip.mine:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3A1EC8C8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
  </Style>
  <Style Selector="Button.reactionchip TextBlock.reactioncount">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Opacity" Value="0.95" />
  </Style>
  <Style Selector="Button.reactionchip.mine TextBlock.reactioncount">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- Floating “New messages” chip above the composer -->
  <Style Selector="Button.newmessages">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ZIndex" Value="5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.newmessages:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
  </Style>
  <Style Selector="Button.newmessages:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
  </Style>

  <!-- Soft reply chip under the bubble (Slack/Teams-style thread affordance) -->
  <Style Selector="Button.replychip">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.replychip.mine">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Button.replychip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#401EC8C8" />
  </Style>
  <Style Selector="Button.replychip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#551EC8C8" />
  </Style>

  <Style Selector="Border.messagebubble">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
    <Setter Property="CornerRadius" Value="14,14,14,4" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,0" />
  </Style>
  <Style Selector="Border.messagebubble.continuation">
    <Setter Property="CornerRadius" Value="4,14,14,4" />
  </Style>
  <Style Selector="Border.messagebubble.mine">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="CornerRadius" Value="14,14,4,14" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.messagebubble.mine.continuation">
    <Setter Property="CornerRadius" Value="14,4,4,14" />
  </Style>

  <!-- Schedule calendar (right pane) -->
  <Style Selector="Calendar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Calendar:focus /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <Style Selector="TextBlock.calendar-dow">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.calendar-day-num">
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="Button.calendar-day">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.calendar-day:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="Button.calendar-day.othermonth TextBlock.calendar-day-num">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.calendar-day.hasmeetings:not(.selected)">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="Button.calendar-day.hasmeetings:not(.selected) Ellipse.calendar-day-dot">
    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.calendar-day.today:not(.selected)">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.calendar-day.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.calendar-day.selected TextBlock.calendar-day-num">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.calendar-day.selected Ellipse.calendar-day-dot">
    <Setter Property="Fill" Value="White" />
  </Style>
  <Style Selector="Ellipse.calendar-day-dot">
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- Active-speaker pulse around call/meeting avatars -->
  <Style Selector="Ellipse.speak-pulse">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Ellipse.speak-pulse.speaking">
    <Setter Property="Opacity" Value="1" />
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="Infinite" Easing="CubicEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.95" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.35" />
          <Setter Property="ScaleTransform.ScaleX" Value="1.12" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.12" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.95" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.meet-tile.speaking">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Meeting join: the stage settles in from slightly small -->
  <Style Selector="Grid.meetingstage.live">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
