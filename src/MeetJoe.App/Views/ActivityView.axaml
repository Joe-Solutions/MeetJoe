<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetJoe.App.ViewModels"
             x:Class="MeetJoe.App.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="stageheader">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h1" VerticalAlignment="Center" Text="Activity" />
        <Button Grid.Column="1" Classes="ghost tint" Content="Mark all read"
                Command="{Binding MarkAllReadCommand}" IsVisible="{Binding HasUnread}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28,18" Spacing="4" MaxWidth="720" HorizontalAlignment="Stretch">
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" Margin="0,0,0,8"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,80,0,0" IsVisible="{Binding IsEmpty}">
          <TextBlock Classes="h2" HorizontalAlignment="Center" Text="You're all caught up" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Replies, reactions, and @mentions will show up here." />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ActivityItemViewModel">
              <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[UserControl].((vm:ActivityViewModel)DataContext).MarkReadCommand}"
                      CommandParameter="{Binding}" Padding="14,12" Margin="0,0,0,2">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                  <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,6,0,0"
                          Background="{StaticResource Brush.Accent}" IsVisible="{Binding IsUnread}" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding KindLabel}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource Brush.Accent}" />
                      <TextBlock Classes="muted small" Text="{Binding TimeText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="20" />
                    <TextBlock Classes="muted small" Text="{Binding Actor.DisplayName}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
