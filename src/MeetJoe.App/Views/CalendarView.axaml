<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetJoe.App.ViewModels"
             xmlns:c="using:MeetJoe.App.Controls"
             x:Class="MeetJoe.App.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">
  <Panel>
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsInMeeting}">
      <Border Classes="stageheader">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h1" VerticalAlignment="Center" Text="Calendar" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost square" Command="{Binding PreviousDayCommand}" ToolTip.Tip="Previous day">
              <TextBlock Text="‹" FontSize="18" />
            </Button>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding SelectedDayLabel}" MinWidth="160" />
            <Button Classes="ghost square" Command="{Binding NextDayCommand}" ToolTip.Tip="Next day">
              <TextBlock Text="›" FontSize="18" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,420" Margin="24,24,24,0">
        <ScrollViewer>
          <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,24,32" Spacing="0">
            <TextBlock Classes="h2" Text="Meet now" />
            <TextBlock Classes="muted" Margin="0,4,0,14" TextWrapping="Wrap"
                       Text="Start a meeting right away. Anyone in your organization can join it from here." />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
              <TextBox Text="{Binding NewMeetingTitle}" Watermark="Meeting title (optional)" />
              <Button Grid.Column="1" Classes="primary" Command="{Binding MeetNowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:Icon Data="{StaticResource Icon.Video}" Size="17" VerticalAlignment="Center" />
                  <TextBlock Text="Meet now" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Classes="separator" Margin="0,28,0,24" />

            <TextBlock Classes="h2" Text="Schedule" />
            <TextBlock Classes="muted" Margin="0,4,0,12" TextWrapping="Wrap"
                       Text="Pick a date on the calendar, set a time, optional lobby, and invite people." />
            <StackPanel Spacing="8">
              <TextBox Text="{Binding ScheduleTitle}" Watermark="Meeting title" />
              <TextBox Text="{Binding ScheduleDescription}" Watermark="Description (optional)"
                       AcceptsReturn="True" Height="64" TextWrapping="Wrap" />
              <TextBox Text="{Binding ScheduleStartsAtText}" Watermark="Starts at (yyyy-MM-dd HH:mm)"
                       ToolTip.Tip="Date updates when you pick a day on the calendar" />
              <CheckBox IsChecked="{Binding ScheduleLobbyEnabled}" Content="Enable lobby" />
              <ItemsControl ItemsSource="{Binding InviteCandidates}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PersonViewModel">
                    <CheckBox Margin="0,0,12,4" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="secondary" HorizontalAlignment="Left" Content="Schedule meeting"
                      Command="{Binding ScheduleCommand}" />
            </StackPanel>

            <TextBlock Classes="error" Margin="0,12,0,0" Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Border Classes="separator" Margin="0,28,0,24" />

            <TextBlock Classes="h2" Text="Happening now" />
            <TextBlock Classes="muted" Margin="0,8,0,0" Text="No meetings are in progress."
                       IsVisible="{Binding IsEmpty}" />

            <ItemsControl ItemsSource="{Binding Meetings}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MeetingViewModel">
                  <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted small" Text="{Binding Summary}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="secondary" Content="Join" VerticalAlignment="Center"
                              IsVisible="{Binding CanJoin}"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).JoinCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Grid.Column="1" Classes="muted small" Text="Meeting Ended"
                                 VerticalAlignment="Center" IsVisible="{Binding HasEnded}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="separator" Margin="0,28,0,24" />

            <TextBlock Classes="h2" Text="Upcoming" />
            <ItemsControl ItemsSource="{Binding Upcoming}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MeetingViewModel">
                  <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted small" Text="{Binding WhenText}" />
                        <TextBlock Classes="muted small" Text="{Binding Summary}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="Accept"
                                IsVisible="{Binding MyInviteStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RespondAcceptCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="ghost" Content="Decline"
                                IsVisible="{Binding MyInviteStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RespondDeclineCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="secondary" Content="Join"
                                IsVisible="{Binding CanJoin}"
                                Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).JoinCommand}"
                                CommandParameter="{Binding}" />
                        <TextBlock Classes="muted small" Text="Meeting Ended" VerticalAlignment="Center"
                                   IsVisible="{Binding HasEnded}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Schedule date picker + meetings on selected day -->
        <Border Grid.Column="1" Classes="schedule-calendar" VerticalAlignment="Stretch" Margin="0,0,0,24"
                Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="12" Padding="18,20">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" FontSize="20" Text="Pick a date" />
              <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                         Text="Days with scheduled meetings are highlighted. Select a day to see its meetings below." />

              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,4">
                <TextBlock Classes="h2" FontSize="18" VerticalAlignment="Center" Text="{Binding MonthLabel}" />
                <Button Grid.Column="1" Classes="ghost square" Command="{Binding PreviousMonthCommand}"
                        ToolTip.Tip="Previous month" Width="36" Height="36">
                  <TextBlock Text="‹" FontSize="22" />
                </Button>
                <Button Grid.Column="2" Classes="ghost square" Command="{Binding NextMonthCommand}"
                        ToolTip.Tip="Next month" Width="36" Height="36">
                  <TextBlock Text="›" FontSize="22" />
                </Button>
              </Grid>

              <UniformGrid Columns="7" Margin="0,4,0,2">
                <TextBlock Classes="muted calendar-dow" Text="Su" />
                <TextBlock Classes="muted calendar-dow" Text="Mo" />
                <TextBlock Classes="muted calendar-dow" Text="Tu" />
                <TextBlock Classes="muted calendar-dow" Text="We" />
                <TextBlock Classes="muted calendar-dow" Text="Th" />
                <TextBlock Classes="muted calendar-dow" Text="Fr" />
                <TextBlock Classes="muted calendar-dow" Text="Sa" />
              </UniformGrid>

              <ItemsControl ItemsSource="{Binding MonthDays}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarDayCellViewModel">
                    <Button Classes="calendar-day"
                            Classes.othermonth="{Binding IsOtherMonth}"
                            Classes.hasmeetings="{Binding HasMeetings}"
                            Classes.selected="{Binding IsSelected}"
                            Classes.today="{Binding IsToday}"
                            Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).SelectDayCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Date}">
                      <StackPanel Spacing="3" HorizontalAlignment="Center" MinHeight="40">
                        <TextBlock Classes="calendar-day-num" Text="{Binding DayNumber}"
                                   HorizontalAlignment="Center" />
                        <Ellipse Classes="calendar-day-dot" Width="6" Height="6"
                                 IsVisible="{Binding HasMeetings}"
                                 HorizontalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="separator" Margin="0,8,0,4" />

              <TextBlock Classes="h2" FontSize="14" Text="{Binding SelectedDayMeetingsHeading}" />
              <TextBlock Classes="muted small" Text="No scheduled meetings on this day."
                         IsVisible="{Binding !HasSelectedDayMeetings}" />

              <ItemsControl ItemsSource="{Binding SelectedDayMeetings}" Margin="0,2,0,0"
                            IsVisible="{Binding HasSelectedDayMeetings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MeetingViewModel">
                    <Border Classes="calendar-day-meeting" Padding="0,10"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding WhenText}" />
                        <TextBlock Classes="muted small" Text="{Binding Description}"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="muted small" Text="{Binding Summary}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                          <Button Classes="ghost" Content="Accept"
                                  IsVisible="{Binding MyInviteStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RespondAcceptCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="ghost" Content="Decline"
                                  IsVisible="{Binding MyInviteStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RespondDeclineCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="secondary" Content="Join"
                                  IsVisible="{Binding CanJoin}"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).JoinCommand}"
                                  CommandParameter="{Binding}" />
                          <TextBlock Classes="muted small" Text="Meeting Ended" VerticalAlignment="Center"
                                     IsVisible="{Binding HasEnded}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- Meeting stage (and its WebView) is created only while in a meeting — see code-behind. -->
    <ContentControl x:Name="StageHost" IsVisible="{Binding IsInMeeting}" />
  </Panel>
</UserControl>
