<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetJoe.App.ViewModels"
             xmlns:c="using:MeetJoe.App.Controls"
             xmlns:contracts="using:MeetJoe.Contracts"
             x:Class="MeetJoe.App.Views.MeetingStageView"
             x:DataType="vm:CalendarViewModel">
  <Panel Classes="meetingstage" Classes.live="{Binding IsInMeeting}" Background="{StaticResource Brush.Rail}">

    <!-- Live meeting: media + right chat + centered icon controls -->
    <Grid ColumnDefinitions="*,300" RowDefinitions="Auto,*,Auto"
          IsVisible="{Binding Stage.IsMediaOpen}">
      <Border Grid.ColumnSpan="2" Classes="stageheader">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="h2" Text="{Binding Stage.Meeting.Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted small" Text="{Binding Stage.Meeting.Summary}" />
        </StackPanel>
      </Border>

      <!-- LiveKit WebView fills the stage grid; Avalonia tiles only while connecting. -->
      <Panel Grid.Row="1" Background="{StaticResource Brush.Rail}">
        <ItemsControl ItemsSource="{Binding Stage.Meeting.Participants}" Margin="16"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      IsHitTestVisible="False" ZIndex="1"
                      IsVisible="{Binding Stage.ShowConnectingTiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.ParticipantGridColumns}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PersonViewModel">
              <Border Classes="meet-tile" Classes.speaking="{Binding IsSpeaking}"
                      Margin="6" MinHeight="180" MaxWidth="420" MinWidth="160"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      CornerRadius="16"
                      Background="{StaticResource Brush.PanelRaised}"
                      BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                <Grid>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                    <Panel Width="112" Height="112">
                      <Ellipse Classes="speak-pulse" Classes.speaking="{Binding IsSpeaking}"
                               Width="112" Height="112"
                               Stroke="{StaticResource Brush.Accent}" StrokeThickness="3"
                               Fill="Transparent">
                        <Ellipse.RenderTransform>
                          <ScaleTransform />
                        </Ellipse.RenderTransform>
                      </Ellipse>
                      <c:Avatar Width="96" Height="96" DisplayName="{Binding DisplayName}" Photo="{Binding Photo}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding DisplayName}"
                                 MaxLines="1" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted small" Text="(You)" IsVisible="{Binding IsMe}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted small" HorizontalAlignment="Center" Text="In the meeting" />
                  </StackPanel>
                  <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                          Width="28" Height="28" CornerRadius="14"
                          Background="#C43B3B"
                          IsVisible="{Binding IsMicMuted}">
                    <c:Icon Data="{StaticResource Icon.MicOff}" Size="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Panel x:Name="MediaHost"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               ZIndex="5"
               IsHitTestVisible="False" />
      </Panel>

      <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
              Background="{StaticResource Brush.Panel}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,10,10,0">
            <Button Classes="secondary" Padding="12,6" MinHeight="32"
                    Command="{Binding Stage.ShowPeopleCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Users}" Size="15" />
                <TextBlock Text="People" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="secondary" Padding="12,6" MinHeight="32"
                    Command="{Binding Stage.ShowChatCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.ChatBubble}" Size="15" />
                <TextBlock Text="Chat" VerticalAlignment="Center" />
                <Border IsVisible="{Binding Stage.HasUnreadChat}" Background="{StaticResource Brush.Accent}"
                        CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Stage.UnreadChatBadge}" FontSize="11" FontWeight="Bold"
                             Foreground="{StaticResource Brush.OnAccent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- People roster (Zoom / Meet / Teams style) -->
          <DockPanel Grid.Row="1" Margin="0,8,0,0" IsVisible="{Binding Stage.ShowPeoplePanel}">
            <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="14,0,14,8"
                       Text="{Binding Stage.Meeting.Summary}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <ScrollViewer Margin="8,0,8,12">
              <ItemsControl ItemsSource="{Binding Stage.Meeting.Participants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PersonViewModel">
                    <Border Padding="8,8" Margin="0,0,0,4" CornerRadius="8"
                            Background="{StaticResource Brush.PanelRaised}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <c:Avatar Width="36" Height="36" DisplayName="{Binding DisplayName}" Photo="{Binding Photo}"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"
                                    MinWidth="0" Margin="0,0,4,0">
                          <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Classes="muted small" Text="You"
                                       IsVisible="{Binding IsMe}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBlock FontWeight="SemiBold" MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding DisplayName}" />
                          </DockPanel>
                          <TextBlock Classes="muted small" Text="In the meeting"
                                     MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    IsVisible="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.Meeting.IsHostedByMe}">
                          <Button Classes="ghost" Padding="8,2" MinHeight="28" Content="Mute"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding !IsMe}"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.MuteCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="ghost" Padding="8,2" MinHeight="28" Content="Remove"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding !IsMe}"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.RemoveCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- Meeting chat (DM-style bubbles) -->
          <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding Stage.ShowChatPanel}">
            <ScrollViewer x:Name="LiveChatScroller" Margin="8,8,8,0">
              <ItemsControl ItemsSource="{Binding Stage.ChatMessages}"
                            ItemTemplate="{StaticResource RoomChatMessageTemplate}"
                            VerticalAlignment="Bottom" />
            </ScrollViewer>
            <StackPanel Grid.Row="1" Margin="8,6,8,8" Spacing="4">
              <ItemsControl ItemsSource="{Binding Stage.PendingAttachments}"
                            IsVisible="{Binding Stage.HasPendingAttachments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingAttachmentViewModel">
                    <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="10"
                            Padding="10,4,4,4" Margin="0,0,6,6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Data="{StaticResource Icon.File}" Size="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileName}" FontSize="12" MaxWidth="120"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Classes="ghost square" Width="24" Height="24" MinHeight="24" ToolTip.Tip="Remove"
                                Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.RemoveChatAttachmentCommand}"
                                CommandParameter="{Binding}">
                          <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="emojipicker" IsVisible="{Binding Stage.ShowEmojiPicker}">
                <ItemsControl ItemsSource="{Binding Stage.EmojiPalette}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="emoji" Content="{Binding}"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.InsertEmojiCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
                <Button Classes="ghost square" VerticalAlignment="Center" ToolTip.Tip="Attach a file"
                        Command="{Binding Stage.AttachChatFileCommand}">
                  <c:Icon Data="{StaticResource Icon.Attach}" Size="16" />
                </Button>
                <Button Grid.Column="1" Classes="ghost square" VerticalAlignment="Center" ToolTip.Tip="Emoji"
                        Command="{Binding Stage.ToggleEmojiPickerCommand}">
                  <c:Icon Data="{StaticResource Icon.Smile}" Size="16" />
                </Button>
                <TextBox x:Name="LiveChatComposer" Grid.Column="2" Classes="roomcomposer"
                         Text="{Binding Stage.ChatDraft}" Watermark="Message the room" />
                <Button Grid.Column="3" Classes="primary" Content="Send" VerticalAlignment="Center"
                        ToolTip.Tip="Send (Enter)" Command="{Binding Stage.SendChatCommand}" />
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
              Padding="16,12" Background="{StaticResource Brush.Panel}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
          <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="Turn camera on or off" Command="{Binding Stage.ToggleCameraCommand}">
            <Panel>
              <c:Icon Data="{StaticResource Icon.Video}" Size="22"
                      IsVisible="{Binding Stage.IsCameraOn}" />
              <c:Icon Data="{StaticResource Icon.VideoOff}" Size="22"
                      IsVisible="{Binding !Stage.IsCameraOn}" />
            </Panel>
          </Button>
          <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="Mute or unmute" Command="{Binding Stage.ToggleMicCommand}">
              <Panel>
              <c:Icon Data="{StaticResource Icon.Mic}" Size="22"
                      IsVisible="{Binding Stage.IsMicOn}" />
              <c:Icon Data="{StaticResource Icon.MicOff}" Size="22"
                      IsVisible="{Binding !Stage.IsMicOn}" />
              </Panel>
            </Button>
          <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="Share or stop sharing your screen"
                  Command="{Binding Stage.ToggleScreenShareCommand}">
            <Panel>
              <c:Icon Data="{StaticResource Icon.ScreenShare}" Size="22"
                      IsVisible="{Binding !Stage.IsScreenShareOn}" />
              <Border IsVisible="{Binding Stage.IsScreenShareOn}"
                      Background="{StaticResource Brush.Accent}" CornerRadius="18"
                      Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:Icon Data="{StaticResource Icon.ScreenShare}" Size="22"
                        TextElement.Foreground="{StaticResource Brush.OnAccent}" />
              </Border>
            </Panel>
          </Button>
          <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="People" Command="{Binding Stage.ShowPeopleCommand}">
            <c:Icon Data="{StaticResource Icon.Users}" Size="22" />
          </Button>
          <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="Chat" Command="{Binding Stage.ShowChatCommand}">
            <Panel>
              <c:Icon Data="{StaticResource Icon.ChatBubble}" Size="22" />
              <Border IsVisible="{Binding Stage.HasUnreadChat}" Background="{StaticResource Brush.Accent}"
                      CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                <TextBlock Text="{Binding Stage.UnreadChatBadge}" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource Brush.OnAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
          </Button>
          <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="Add people" Command="{Binding Stage.BeginAddPeopleCommand}">
            <c:Icon Data="{StaticResource Icon.UserPlus}" Size="22" />
          </Button>
          <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="End for everyone" Command="{Binding EndCommand}"
                  IsVisible="{Binding Stage.Meeting.IsHostedByMe}">
            <c:Icon Data="{StaticResource Icon.EndCall}" Size="22" />
          </Button>
          <Button Classes="danger" Width="52" Height="52" Padding="0" CornerRadius="26"
                  ToolTip.Tip="Leave meeting" Command="{Binding LeaveCommand}">
            <c:Icon Data="{StaticResource Icon.Leave}" Size="22" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Lobby / roster before immersive media -->
    <Grid ColumnDefinitions="*,280" RowDefinitions="Auto,Auto,*,Auto"
          IsVisible="{Binding !Stage.IsMediaOpen}">
      <Border Grid.ColumnSpan="2" Classes="stageheader">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="h2" Text="{Binding Stage.Meeting.Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted small" Text="{Binding Stage.Meeting.Summary}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Brush.Panel}" Padding="24,10"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
              IsVisible="{Binding Stage.InLobby}">
        <TextBlock FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center">
          <Run FontWeight="Bold" Text="You're in the lobby." />
          <Run Foreground="{StaticResource Brush.TextMuted}"
               Text=" Camera and mic unlock after the host admits you." />
        </TextBlock>
      </Border>

      <ScrollViewer Grid.Row="2" Grid.Column="0">
        <StackPanel Margin="24" Spacing="16">
          <TextBlock Classes="h2" Text="In the lobby" IsVisible="{Binding Stage.InLobby}" />
          <TextBlock Classes="muted" Text="Waiting for the host to admit you…" IsVisible="{Binding Stage.InLobby}" />

          <TextBlock Classes="muted small" Text="Lobby"
                     IsVisible="{Binding Stage.Meeting.IsHostedByMe}" />
          <ItemsControl ItemsSource="{Binding Stage.Meeting.Lobby}"
                        IsVisible="{Binding Stage.Meeting.IsHostedByMe}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PersonViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="secondary" Content="Admit" Margin="8,0"
                          Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.AdmitCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="ghost" Content="Reject"
                          Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.RejectCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Stage.Meeting.Participants}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PersonViewModel">
                <Border Width="220" Height="160" Margin="6" Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="8"
                                IsVisible="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.Meeting.IsHostedByMe}">
                      <Button Classes="ghost" Padding="8,2" Content="Mute"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.MuteCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="ghost" Padding="8,2" Content="Remove"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.RemoveCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                    <Panel>
                      <c:Avatar Width="64" Height="64" DisplayName="{Binding DisplayName}" Photo="{Binding Photo}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,12,10"
                                 MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
              Background="{StaticResource Brush.Panel}">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="h2" Margin="14,12" Text="Meeting chat" />
          <ScrollViewer x:Name="LobbyChatScroller" Grid.Row="1" Margin="8,0">
            <ItemsControl ItemsSource="{Binding Stage.ChatMessages}"
                          ItemTemplate="{StaticResource RoomChatMessageTemplate}"
                          VerticalAlignment="Bottom" />
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="8,6,8,8" Spacing="4" IsVisible="{Binding !Stage.InLobby}">
            <ItemsControl ItemsSource="{Binding Stage.PendingAttachments}"
                          IsVisible="{Binding Stage.HasPendingAttachments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PendingAttachmentViewModel">
                  <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="10"
                          Padding="10,4,4,4" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Data="{StaticResource Icon.File}" Size="14" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FileName}" FontSize="12" MaxWidth="120"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Classes="ghost square" Width="24" Height="24" MinHeight="24" ToolTip.Tip="Remove"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.RemoveChatAttachmentCommand}"
                              CommandParameter="{Binding}">
                        <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="emojipicker" IsVisible="{Binding Stage.ShowEmojiPicker}">
              <ItemsControl ItemsSource="{Binding Stage.EmojiPalette}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="emoji" Content="{Binding}"
                            Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.InsertEmojiCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
              <Button Classes="ghost square" VerticalAlignment="Center" ToolTip.Tip="Attach a file"
                      Command="{Binding Stage.AttachChatFileCommand}">
                <c:Icon Data="{StaticResource Icon.Attach}" Size="16" />
              </Button>
              <Button Grid.Column="1" Classes="ghost square" VerticalAlignment="Center" ToolTip.Tip="Emoji"
                      Command="{Binding Stage.ToggleEmojiPickerCommand}">
                <c:Icon Data="{StaticResource Icon.Smile}" Size="16" />
              </Button>
              <TextBox x:Name="LobbyChatComposer" Grid.Column="2" Classes="roomcomposer"
                       Text="{Binding Stage.ChatDraft}" Watermark="Message the room" />
              <Button Grid.Column="3" Classes="primary" Content="Send" VerticalAlignment="Center"
                      ToolTip.Tip="Send (Enter)" Command="{Binding Stage.SendChatCommand}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
              Padding="24,14">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="error" VerticalAlignment="Center" Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                    ToolTip.Tip="Add people" Command="{Binding Stage.BeginAddPeopleCommand}"
                    IsVisible="{Binding !Stage.InLobby}">
              <c:Icon Data="{StaticResource Icon.UserPlus}" Size="22" />
            </Button>
            <Button Classes="secondary" Content="Raise / lower hand"
                    Command="{Binding Stage.RaiseHandCommand}" IsVisible="{Binding !Stage.InLobby}" />
            <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                    ToolTip.Tip="End for everyone" Command="{Binding EndCommand}"
                    IsVisible="{Binding Stage.Meeting.IsHostedByMe}">
              <c:Icon Data="{StaticResource Icon.EndCall}" Size="22" />
            </Button>
            <Button Classes="danger" Width="52" Height="52" Padding="0" CornerRadius="26"
                    ToolTip.Tip="Leave meeting" Command="{Binding LeaveCommand}">
              <c:Icon Data="{StaticResource Icon.Leave}" Size="22" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Add people — works in lobby and during live media -->
    <Border ZIndex="30" Background="#CC050D16" IsVisible="{Binding Stage.ShowAddPeople}">
      <Border Width="440" MaxWidth="520" Padding="20" CornerRadius="14"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource Brush.PanelRaised}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
        <StackPanel Spacing="12">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="ghost square" Command="{Binding Stage.CancelAddPeopleCommand}"
                    ToolTip.Tip="Close">
              <c:Icon Data="{StaticResource Icon.Close}" Size="16" />
            </Button>
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="Add people" />
              <TextBlock Classes="muted small" Text="Type an email to find someone in your organization." />
            </StackPanel>
          </DockPanel>

          <TextBox Text="{Binding Stage.InviteQuery, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="Email" MaxLength="200" />

          <Border IsVisible="{Binding Stage.HasInviteSuggestions}"
                  Background="{StaticResource Brush.Panel}" CornerRadius="8"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" MaxHeight="220">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Stage.InviteSuggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PersonViewModel">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="12,10" CornerRadius="0"
                            Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).Stage.PickInviteSuggestionCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:Avatar Width="32" Height="32" DisplayName="{Binding DisplayName}" Photo="{Binding Photo}" />
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                          <TextBlock Classes="muted small" Text="{Binding Email}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <TextBlock Classes="error" Text="{Binding Stage.AddPeopleStatus}"
                     IsVisible="{Binding Stage.AddPeopleStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Send invite" IsDefault="True"
                    Command="{Binding Stage.InvitePeopleCommand}" />
            <Button Classes="ghost" Content="Cancel" Command="{Binding Stage.CancelAddPeopleCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
