<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetJoe.App.ViewModels"
             xmlns:c="using:MeetJoe.App.Controls"
             x:Class="MeetJoe.App.Views.MessageThreadView"
             x:DataType="vm:MessageThreadViewModel">
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
    <!-- Messages -->
    <ScrollViewer x:Name="Scroller" Grid.Row="0" Grid.Column="0">
      <StackPanel Margin="24,16,24,8" VerticalAlignment="Bottom">
        <Button Classes="ghost tint" HorizontalAlignment="Center" Margin="0,0,0,8"
                Content="Show earlier messages" Command="{Binding LoadOlderCommand}"
                IsVisible="{Binding HasOlder}" />

        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageViewModel">
              <DockPanel Classes="message" Classes.first="{Binding StartsGroup}"
                         Classes.mine="{Binding IsMine}" Classes.continuation="{Binding IsContinuation}">
                <!-- Fixed gutter so consecutive other-user bubbles share one left edge. Own messages omit this. -->
                <Panel DockPanel.Dock="Left" Width="44" IsVisible="{Binding !IsMine}">
                  <c:Avatar Width="34" Height="34" VerticalAlignment="Top" Margin="0,2,0,0"
                            DisplayName="{Binding Sender.DisplayName}" Photo="{Binding Sender.Photo}"
                            IsVisible="{Binding ShowAvatar}"
                            Surface="{StaticResource Brush.Canvas}" />
                </Panel>

                <StackPanel Classes="messagebody" Classes.mine="{Binding IsMine}" Spacing="3">
                  <!-- Teams-style header: name/time on one side, reaction pill on the other — never over bubble text. -->
                  <Grid Classes="messageheader" Classes.mine="{Binding IsMine}"
                        Classes.continuation="{Binding IsContinuation}"
                        MinWidth="160">
                    <StackPanel Classes="messagemeta" Classes.mine="{Binding IsMine}"
                                Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding StartsGroup}">
                      <TextBlock Text="{Binding Sender.DisplayName}" FontWeight="Bold" FontSize="13"
                                 IsVisible="{Binding !IsMine}" />
                      <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding TimeText}" />
                      <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="edited"
                                 IsVisible="{Binding ShowEdited}" />
                    </StackPanel>

                    <Border Classes="message-hoverbar" Classes.mine="{Binding IsMine}"
                            VerticalAlignment="Center" IsVisible="{Binding ShowActions}"
                            ZIndex="2"
                            BoxShadow="0 8 20 0 #55000000">
                      <StackPanel Orientation="Horizontal" Spacing="0">
                        <ItemsControl ItemsSource="{Binding ReactionChoices}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="0" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Button Classes="hoverreact"
                                      Content="{Binding}"
                                      ToolTip.Tip="{Binding}"
                                      ToolTip.Placement="Top"
                                      Command="{Binding $parent[ItemsControl].((vm:MessageViewModel)DataContext).ReactCommand}"
                                      CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Classes="hoverbardivider" />

                        <Button Classes="hovericon" ToolTip.Tip="Reply" ToolTip.Placement="Top"
                                Command="{Binding BeginReplyCommand}">
                          <c:Icon Data="{StaticResource Icon.Reply}" Size="14" />
                        </Button>
                        <Button Classes="hovericon" ToolTip.Tip="Edit" ToolTip.Placement="Top"
                                Command="{Binding BeginEditCommand}"
                                IsVisible="{Binding CanMutate}">
                          <c:Icon Data="{StaticResource Icon.Edit}" Size="14" />
                        </Button>
                        <Button Classes="hovericon danger" ToolTip.Tip="Delete" ToolTip.Placement="Top"
                                Command="{Binding DeleteCommand}"
                                IsVisible="{Binding CanMutate}">
                          <c:Icon Data="{StaticResource Icon.Trash}" Size="14" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <StackPanel Classes="messagechrome" Classes.mine="{Binding IsMine}" Spacing="4">
                    <Border Classes="messagebubble" Classes.mine="{Binding IsMine}"
                            Classes.continuation="{Binding IsContinuation}"
                            IsVisible="{Binding !IsEditing}">
                      <StackPanel Spacing="6">
                        <c:MarkdownText Markdown="{Binding DisplayBody}" TextWrapping="Wrap" LineHeight="21"
                                        Classes.muted="{Binding IsDeleted}" />

                        <Border Margin="0,2,0,0" Padding="10,8" Background="{StaticResource Brush.Panel}"
                                CornerRadius="8" IsVisible="{Binding HasLinkPreview}">
                          <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding LinkPreview.Title}"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted small" Text="{Binding LinkPreview.Url}"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted small" Text="{Binding LinkPreview.Description}"
                                       IsVisible="{Binding LinkPreview.Description, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding !IsDeleted}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttachmentViewModel">
                              <StackPanel Margin="0,4,0,0" Spacing="6">
                                <Border IsVisible="{Binding IsImage}" CornerRadius="10" ClipToBounds="True"
                                        Background="{StaticResource Brush.PanelRaised}" MaxWidth="340">
                                  <Panel>
                                    <TextBlock Classes="muted small" Margin="12" Text="Loading image…"
                                               IsVisible="{Binding IsLoadingPreview}" />
                                    <Button Classes="ghost" Padding="0" Cursor="Hand"
                                            Background="Transparent"
                                            Command="{Binding OpenFullscreenCommand}"
                                            IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="View full screen">
                                      <Image Source="{Binding Preview}" MaxWidth="340" MaxHeight="280"
                                             Stretch="Uniform" />
                                    </Button>
                                  </Panel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="10"
                                            IsVisible="{Binding ShowFileChip}">
                                  <Button Classes="secondary" Padding="12,6" Command="{Binding DownloadCommand}"
                                          ToolTip.Tip="Save this file">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <c:Icon Data="{StaticResource Icon.File}" Size="17" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding FileName}" MaxWidth="280" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" />
                                      <TextBlock Classes="muted small" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Button>
                                  <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding Status}" />
                                </StackPanel>
                                <Button Classes="ghost" HorizontalAlignment="Left" Padding="4,2"
                                        Content="Save image" FontSize="12"
                                        IsVisible="{Binding IsImage}"
                                        Command="{Binding DownloadCommand}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Button Classes="replychip" Classes.mine="{Binding IsMine}"
                            Command="{Binding OpenRepliesCommand}"
                            IsVisible="{Binding HasReplies}"
                            ToolTip.Tip="Open thread">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.ChatBubble}" Size="13"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RepliesLabel}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding IsEditing}" Margin="0,2,0,0">
                    <TextBox Classes="messageedit" Text="{Binding EditDraft}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                             Watermark="Edit message" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Content="Save" Command="{Binding SaveEditCommand}"
                              ToolTip.Tip="Save (Enter)" Padding="12,6" MinHeight="30" />
                      <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEditCommand}"
                              ToolTip.Tip="Cancel (Esc)" Padding="12,6" MinHeight="30" />
                    </StackPanel>
                  </StackPanel>

                  <ItemsControl Classes="messagereactions" Classes.mine="{Binding IsMine}"
                                ItemsSource="{Binding Reactions}" IsVisible="{Binding HasReactions}"
                                Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReactionChipViewModel">
                        <Button Classes="reactionchip" Classes.mine="{Binding ReactedByMe}"
                                Margin="0,0,6,6"
                                Command="{Binding $parent[ItemsControl].((vm:MessageViewModel)DataContext).ToggleChipCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Toggle reaction">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Emoji}" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Classes="reactioncount" Text="{Binding Count}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Thread side panel -->
    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Width="320" Classes="panel"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
            IsVisible="{Binding ShowThreadPanel}" Background="{StaticResource Brush.Panel}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="stageheader" Padding="16,12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="Thread" />
              <TextBlock Classes="muted small" Text="{Binding OpenThread.Sender.DisplayName}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost square" Command="{Binding CloseThreadCommand}" ToolTip.Tip="Close">
              <c:Icon Data="{StaticResource Icon.Close}" Size="16" />
            </Button>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="16,12" Spacing="10">
            <TextBlock Text="{Binding OpenThread.DisplayBody}" TextWrapping="Wrap" LineHeight="21"
                       Opacity="0.85" />
            <TextBlock Classes="muted small" Text="Loading replies…" IsVisible="{Binding IsLoadingReplies}" />
            <ItemsControl ItemsSource="{Binding ThreadReplies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageViewModel">
                  <StackPanel Spacing="2" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Sender.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding TimeText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayBody}" TextWrapping="Wrap" LineHeight="20" FontSize="13.5" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Classes="muted small" Margin="16,0,16,14"
                   Text="Replies use the composer below." />
      </Grid>
    </Border>

    <!-- Nothing here yet -->
    <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                IsVisible="{Binding IsEmpty}">
      <TextBlock Classes="h2" HorizontalAlignment="Center" Text="No messages yet" />
      <TextBlock Classes="muted" HorizontalAlignment="Center" Text="Say hello to get things started." />
    </StackPanel>

    <!-- Composer + floating “New messages” chip (upper-right of the field) -->
    <Panel Grid.Row="1" Grid.Column="0">
    <StackPanel Margin="24,4,24,18" Spacing="6">
      <TextBlock Classes="muted small" Text="{Binding TypingText}"
                 IsVisible="{Binding TypingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="8" Padding="10,6"
              IsVisible="{Binding IsReplying}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="muted small" VerticalAlignment="Center"
                     Text="{Binding ReplyTarget.Sender.DisplayName, StringFormat=Replying to {0}}" />
          <Button Grid.Column="1" Classes="ghost square" Width="24" Height="24" MinHeight="24"
                  Command="{Binding CancelReplyCommand}" ToolTip.Tip="Cancel reply">
            <c:Icon Data="{StaticResource Icon.Close}" Size="14" />
          </Button>
        </Grid>
      </Border>

      <Border Classes="composer">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="8,6,8,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PendingAttachmentViewModel">
                <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="10"
                        Padding="10,4,4,4" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:Icon Data="{StaticResource Icon.File}" Size="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FileName}" FontSize="13" MaxWidth="240"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Classes="muted small" Text="{Binding SizeText}" VerticalAlignment="Center" />
                    <Button Classes="ghost square" Width="24" Height="24" MinHeight="24" ToolTip.Tip="Remove"
                            Command="{Binding $parent[UserControl].((vm:MessageThreadViewModel)DataContext).RemoveAttachmentCommand}"
                            CommandParameter="{Binding}">
                      <c:Icon Data="{StaticResource Icon.Close}" Size="14" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="composer-toolbar">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="composertool" FontWeight="Bold" FontSize="13" Content="B"
                      ToolTip.Tip="Bold" Command="{Binding WrapMarkdownCommand}" CommandParameter="**" />
              <Button Classes="composertool" FontStyle="Italic" FontSize="13" Content="I"
                      ToolTip.Tip="Italic" Command="{Binding WrapMarkdownCommand}" CommandParameter="*" />
              <Button Classes="composertool" ToolTip.Tip="Inline code"
                      Command="{Binding WrapMarkdownCommand}" CommandParameter="`">
                <c:Icon Data="{StaticResource Icon.Code}" Size="15" />
              </Button>
              <Button Classes="composertool" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" Content="```"
                      ToolTip.Tip="Code block" Command="{Binding WrapMarkdownCommand}" CommandParameter="codeblock" />
              <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource Brush.Border}"
                      VerticalAlignment="Center" />
              <Button Classes="composertool" ToolTip.Tip="Emoji" Command="{Binding ToggleEmojiPickerCommand}">
                <c:Icon Data="{StaticResource Icon.Smile}" Size="16" />
              </Button>
            </StackPanel>
          </Border>

          <Border Classes="emojipicker" IsVisible="{Binding ShowEmojiPicker}">
            <ItemsControl ItemsSource="{Binding EmojiPalette}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="emoji" Content="{Binding}"
                          Command="{Binding $parent[UserControl].((vm:MessageThreadViewModel)DataContext).InsertEmojiCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="8,6,6,4">
            <TextBox x:Name="Composer" Classes="bare" Text="{Binding Draft}" Watermark="{Binding Placeholder}"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="composertool" Width="36" Height="36" MinHeight="36"
                    VerticalAlignment="Bottom" ToolTip.Tip="Attach a file" Command="{Binding AttachCommand}">
              <c:Icon Data="{StaticResource Icon.Attach}" Size="18" />
            </Button>
            <Button Grid.Column="2" Classes="send" VerticalAlignment="Bottom"
                    ToolTip.Tip="Send (Enter)" Command="{Binding SendCommand}">
              <c:Icon Data="{StaticResource Icon.Send}" Size="16" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

      <Button Classes="newmessages"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,-40,28,0"
              IsVisible="{Binding ShowNewMessagesHint}"
              Command="{Binding JumpToLatestCommand}"
              ToolTip.Tip="Jump to the latest messages">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <c:Icon Data="{StaticResource Icon.ArrowDown}" Size="14"
                  VerticalAlignment="Center" Margin="0,1,0,0" />
          <TextBlock Text="New messages" FontWeight="SemiBold" FontSize="12.5"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Panel>
  </Grid>
</UserControl>
