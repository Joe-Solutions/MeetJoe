<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetJoe.App.ViewModels"
             xmlns:c="using:MeetJoe.App.Controls"
             xmlns:contracts="using:MeetJoe.Contracts"
             x:Class="MeetJoe.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="RailItemTemplate" x:DataType="vm:RailItemViewModel">
      <Button Classes="rail" Classes.selected="{Binding IsSelected}"
              Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NavigateCommand}"
              CommandParameter="{Binding}">
        <Panel>
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <c:Icon Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="21"
                    HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>
          <Border IsVisible="{Binding HasBadge}" Background="{StaticResource Brush.Accent}"
                  CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0">
            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource Brush.OnAccent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="80,*">
    <!-- Left rail -->
    <Border Background="{StaticResource Brush.Rail}">
      <DockPanel Margin="0,14,0,12">
        <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="10" Margin="0,0,0,16"
                Background="{StaticResource Brush.Accent}" ToolTip.Tip="{Binding OrganizationName}">
          <TextBlock Text="mj" FontSize="16" FontWeight="ExtraBold" LetterSpacing="-0.5"
                     Foreground="{StaticResource Brush.OnAccent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <ContentControl Content="{Binding SettingsItem}" ContentTemplate="{StaticResource RailItemTemplate}" />
          <c:Avatar Width="34" Height="34" HorizontalAlignment="Center"
                    DisplayName="{Binding Me.DisplayName}" Photo="{Binding Me.Photo}"
                    Status="{Binding Me.Status}" ShowStatus="True"
                    Surface="{StaticResource Brush.Rail}" ToolTip.Tip="{Binding Me.DisplayName}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding RailItems}" ItemTemplate="{StaticResource RailItemTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Panel Grid.Column="1">
      <Grid RowDefinitions="Auto,Auto,*">
        <!-- Lost connection -->
        <Border Grid.Row="0" Background="{StaticResource Brush.DangerSoft}" Padding="24,8"
                IsVisible="{Binding !IsConnected}">
          <TextBlock FontSize="13" Text="Connection lost. Reconnecting — new messages will appear once you're back online." />
        </Border>

        <!-- Still in a meeting while looking at another section -->
        <Border Grid.Row="1" Background="{StaticResource Brush.AccentSoft}" Padding="24,6,16,6"
                IsVisible="{Binding ShowMeetingBanner}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="ghost tint" Content="Return to meeting"
                    Command="{Binding ReturnToMeetingCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <c:Icon Data="{StaticResource Icon.Video}" Size="18" />
              <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                <Run Text="You're in" />
                <Run Text="{Binding Calendar.Stage.Meeting.Title}" />
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>

        <TransitioningContentControl Grid.Row="2" Content="{Binding Current}">
          <TransitioningContentControl.PageTransition>
            <c:SlideFadeTransition />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
      </Grid>

      <!-- Teams-style floating bar while browsing during an active call -->
      <Border VerticalAlignment="Top" Margin="16,12,16,0" Padding="12,10" CornerRadius="12" ZIndex="20"
              Background="{StaticResource Brush.PanelRaised}" BoxShadow="0 8 28 0 #66000000"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
              IsVisible="{Binding ShowCallBar}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="secondary" Content="Return to call" Command="{Binding ReturnToCallCommand}" />
            <Button Classes="danger" Content="Leave" Command="{Binding Calls.HangUpCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <c:Avatar Width="36" Height="36"
                      DisplayName="{Binding Calls.ActivePeerName}"
                      Photo="{Binding Calls.ActivePeerPerson.Photo}" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding Calls.ActivePeerName}" />
              <TextBlock Classes="muted small" Text="{Binding Calls.CallStatusLabel}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!--
        Single LiveKit host for the active call. Expanded = full stage; minimized = 1×1 keep-alive
        so navigating away from Calls does not tear down the WebView (audio stays up).
      -->
      <Grid x:Name="CallStageRoot" ZIndex="30" IsVisible="False" Background="{StaticResource Brush.Rail}"
            ColumnDefinitions="*,280" RowDefinitions="Auto,*,Auto">
        <Border x:Name="CallStageHeader" Grid.ColumnSpan="2" Background="{StaticResource Brush.Panel}" Padding="16,10"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="secondary" Width="40" Height="40" Padding="0" CornerRadius="20"
                      ToolTip.Tip="People" Command="{Binding Calls.ShowPeopleCommand}">
                <c:Icon Data="{StaticResource Icon.Users}" Size="18" />
              </Button>
              <Button Classes="secondary" Width="40" Height="40" Padding="0" CornerRadius="20"
                      ToolTip.Tip="Chat" Command="{Binding Calls.ShowChatCommand}">
                <c:Icon Data="{StaticResource Icon.ChatBubble}" Size="18" />
              </Button>
              <Button Classes="secondary" Width="40" Height="40" Padding="0" CornerRadius="20"
                      ToolTip.Tip="Add people" Command="{Binding Calls.BeginAddPeopleCommand}">
                <c:Icon Data="{StaticResource Icon.UserPlus}" Size="18" />
              </Button>
              <Button Classes="secondary" Content="Minimize" Command="{Binding Calls.MinimizeStageCommand}"
                      ToolTip.Tip="Keep the call and return to MeetJoe" />
              <Button Classes="danger" Content="Leave" Command="{Binding Calls.HangUpCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <c:Avatar Width="40" Height="40"
                        DisplayName="{Binding Calls.ActivePeerName}"
                        Photo="{Binding Calls.ActivePeerPerson.Photo}" />
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="{Binding Calls.ActivePeerName}" />
                <TextBlock Classes="muted small" Text="{Binding Calls.CallStatusLabel}" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!--
          Avalonia Meet tiles own the stage (never hide — WebView blank-out looked like “no grid”).
          LiveKit WKWebView sits in an uncovered PiP so macOS capture/playback is not occluded.
        -->
        <Panel Grid.Row="1" Background="{StaticResource Brush.Rail}">
          <ItemsControl x:Name="CallRosterTiles" ItemsSource="{Binding Calls.Roster}" Margin="16"
                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        IsHitTestVisible="False" ZIndex="1">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Calls.RosterGridColumns}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CallRosterItemViewModel">
                <Border Classes="meet-tile" Classes.speaking="{Binding IsSpeaking}"
                        Margin="6" MinHeight="180" MaxWidth="420" MinWidth="160"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        CornerRadius="16"
                        Background="{StaticResource Brush.PanelRaised}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                  <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                      <Panel Width="112" Height="112">
                        <Ellipse Classes="speak-pulse" Classes.speaking="{Binding IsSpeaking}"
                                 Width="112" Height="112"
                                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="3"
                                 Fill="Transparent">
                          <Ellipse.RenderTransform>
                            <ScaleTransform />
                          </Ellipse.RenderTransform>
                        </Ellipse>
                        <c:Avatar Width="96" Height="96" DisplayName="{Binding Name}"
                                  Photo="{Binding Person.Photo}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                      <TextBlock FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"
                                 Text="{Binding DisplayName}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted small" HorizontalAlignment="Center" Text="{Binding StatusText}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Padding="8,3" CornerRadius="8"
                            Background="{StaticResource Brush.AccentSoft}"
                            IsVisible="{Binding IsJoined}">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Text="Live"
                                 Foreground="{StaticResource Brush.Accent}" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Padding="8,3" CornerRadius="8"
                            Background="{StaticResource Brush.Panel}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            IsVisible="{Binding IsRinging}">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Classes="muted" Text="Ringing" />
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                            Width="28" Height="28" CornerRadius="14"
                            Background="#C43B3B"
                            IsVisible="{Binding IsMicMuted}">
                      <c:Icon Data="{StaticResource Icon.MicOff}" Size="14"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Uncovered LiveKit surface (PiP). Must not sit under Avalonia tiles on macOS. -->
          <Panel x:Name="CallMediaHost"
                 Width="320" Height="180"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="12" ZIndex="5"
                 IsHitTestVisible="False" />
        </Panel>

        <!-- Camera / mic controls -->
        <Border x:Name="CallStageControls" Grid.Row="2" Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="16,12">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
            <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                    ToolTip.Tip="Turn camera on or off" Command="{Binding Calls.ToggleCameraCommand}">
              <Panel>
                <c:Icon Data="{StaticResource Icon.Video}" Size="22"
                        IsVisible="{Binding Calls.IsCameraOn}" />
                <c:Icon Data="{StaticResource Icon.VideoOff}" Size="22"
                        IsVisible="{Binding !Calls.IsCameraOn}" />
              </Panel>
            </Button>
            <Button Classes="secondary" Width="52" Height="52" Padding="0" CornerRadius="26"
                    ToolTip.Tip="Mute or unmute" Command="{Binding Calls.ToggleMicCommand}">
              <Panel>
                <c:Icon Data="{StaticResource Icon.Mic}" Size="22"
                        IsVisible="{Binding Calls.IsMicOn}" />
                <c:Icon Data="{StaticResource Icon.MicOff}" Size="22"
                        IsVisible="{Binding !Calls.IsMicOn}" />
              </Panel>
            </Button>
            <Button Classes="danger" Width="52" Height="52" Padding="0" CornerRadius="26"
                    ToolTip.Tip="Leave call" Command="{Binding Calls.HangUpCommand}">
              <c:Icon Data="{StaticResource Icon.Leave}" Size="22" />
            </Button>
          </StackPanel>
        </Border>

        <!-- People / chat rail -->
        <Border Grid.Row="1" Grid.RowSpan="1" Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
                Background="{StaticResource Brush.Panel}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,10,10,0">
              <Button Classes="secondary" Padding="12,6" MinHeight="32"
                      Command="{Binding Calls.ShowPeopleCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Users}" Size="15" />
                  <TextBlock Text="People" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Padding="12,6" MinHeight="32"
                      Command="{Binding Calls.ShowChatCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.ChatBubble}" Size="15" />
                  <TextBlock Text="Chat" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,8,0,0" IsVisible="{Binding Calls.ShowPeoplePanel}">
              <TextBlock DockPanel.Dock="Top" Classes="h2" Margin="14,4,14,0" Text="{Binding Calls.RosterTitle}" />
              <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="14,0,14,8"
                         Text="Everyone currently in this call." />
              <ScrollViewer Margin="8,0,8,12">
                <ItemsControl ItemsSource="{Binding Calls.Roster}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CallRosterItemViewModel">
                      <Border Padding="8,8" Margin="0,0,0,4" CornerRadius="8"
                              Background="{StaticResource Brush.PanelRaised}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                          <c:Avatar Width="36" Height="36" DisplayName="{Binding Name}"
                                    Photo="{Binding Person.Photo}" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted small" Text="{Binding StatusText}" />
                          </StackPanel>
                          <Border Grid.Column="2" VerticalAlignment="Center"
                                  Width="26" Height="26" CornerRadius="13"
                                  Background="#C43B3B"
                                  IsVisible="{Binding IsMicMuted}"
                                  ToolTip.Tip="Muted">
                            <c:Icon Data="{StaticResource Icon.MicOff}" Size="13"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Grid.Column="3" VerticalAlignment="Center" Padding="8,3" CornerRadius="8"
                                  Background="{StaticResource Brush.AccentSoft}"
                                  IsVisible="{Binding IsJoined}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Live"
                                       Foreground="{StaticResource Brush.Accent}" />
                          </Border>
                          <Border Grid.Column="3" VerticalAlignment="Center" Padding="8,3" CornerRadius="8"
                                  Background="{StaticResource Brush.Panel}"
                                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                  IsVisible="{Binding IsRinging}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Classes="muted" Text="Ringing" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>

            <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="0,8,0,0"
                  IsVisible="{Binding Calls.ShowChatPanel}">
              <TextBlock Classes="h2" Margin="14,4,14,8" Text="Chat" />
              <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
                <ItemsControl ItemsSource="{Binding Calls.ChatMessages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="contracts:MessageDto">
                      <StackPanel Margin="0,0,0,10" Spacing="2">
                        <TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding Sender.DisplayName}" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding Body}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="10">
                <TextBox x:Name="CallChatComposer" Text="{Binding Calls.ChatDraft}"
                         Watermark="Message everyone on the call" />
                <Button Grid.Column="1" Classes="primary" Margin="6,0,0,0" Content="Send"
                        ToolTip.Tip="Send (Enter)" Command="{Binding Calls.SendChatCommand}" />
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Add people to the active call -->
      <Border ZIndex="45" Background="#CC050D16" IsVisible="{Binding Calls.ShowAddPeople}">
        <Border Width="440" Padding="20" CornerRadius="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.PanelRaised}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                BoxShadow="0 16 48 0 #80000000">
          <StackPanel Spacing="12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost square" Command="{Binding Calls.CancelAddPeopleCommand}"
                      ToolTip.Tip="Close">
                <c:Icon Data="{StaticResource Icon.Close}" Size="16" />
              </Button>
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="Add people" />
                <TextBlock Classes="muted small" Text="Type an email to find someone in your organization." />
              </StackPanel>
            </DockPanel>

            <TextBox Text="{Binding Calls.InviteQuery, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="Email" MaxLength="200" />

            <Border IsVisible="{Binding Calls.HasInviteSuggestions}"
                    Background="{StaticResource Brush.Panel}" CornerRadius="8"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" MaxHeight="220">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Calls.InviteSuggestions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PersonViewModel">
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="12,10" CornerRadius="0"
                              Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Calls.PickInviteSuggestionCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <c:Avatar Width="32" Height="32" DisplayName="{Binding DisplayName}" />
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                            <TextBlock Classes="muted small" Text="{Binding Email}" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <TextBlock Classes="error" Text="{Binding Calls.AddPeopleStatus}"
                       IsVisible="{Binding Calls.AddPeopleStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Ring" IsDefault="True"
                      Command="{Binding Calls.InvitePeopleCommand}" />
              <Button Classes="ghost" Content="Cancel" Command="{Binding Calls.CancelAddPeopleCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- Meeting invite toast — join from any section -->
      <Border ZIndex="35" Width="360" Margin="0,0,20,20" Padding="16"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              CornerRadius="14" Background="{StaticResource Brush.PanelRaised}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
              BoxShadow="0 12 40 0 #80000000"
              IsVisible="{Binding ShowMeetingInviteToast}">
        <StackPanel Spacing="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Classes="muted small" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Accent}" Text="Meeting invite" />
            <TextBlock Classes="muted small" HorizontalAlignment="Right"
                       Text="{Binding PendingMeetingInvite.TimeText}" />
          </DockPanel>
          <DockPanel LastChildFill="True">
            <c:Avatar DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0"
                      DisplayName="{Binding PendingMeetingInvite.ActorName}" />
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                         Text="{Binding PendingMeetingInvite.Summary}" />
              <TextBlock Classes="muted small" Text="{Binding PendingMeetingInvite.ActorName}" />
            </StackPanel>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" MinWidth="88" Content="Cancel"
                    Command="{Binding DismissMeetingInviteCommand}" />
            <Button Classes="primary" MinWidth="88" Content="Join"
                    Command="{Binding JoinMeetingInviteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Call declined toast — notify the caller -->
      <Border ZIndex="36" Width="360" Margin="0,0,20,20" Padding="16"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              CornerRadius="14" Background="{StaticResource Brush.PanelRaised}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
              BoxShadow="0 12 40 0 #80000000"
              IsVisible="{Binding ShowCallDeclinedToast}">
        <StackPanel Spacing="12">
          <TextBlock Classes="muted small" FontWeight="SemiBold"
                     Foreground="{StaticResource Brush.Danger}" Text="Call declined" />
          <DockPanel LastChildFill="True">
            <c:Avatar DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0"
                      DisplayName="{Binding PendingCallDeclined.PeerName}" />
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                         Text="{Binding PendingCallDeclined.Message}" />
              <TextBlock Classes="muted small" Text="They declined the incoming call." />
            </StackPanel>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" MinWidth="88" Content="Dismiss"
                    Command="{Binding DismissCallDeclinedCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Incoming call — answer from any section -->
      <Border ZIndex="40" Background="#CC050D16" IsVisible="{Binding ShowIncomingCall}">
        <Border Width="420" Padding="28" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.PanelRaised}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                BoxShadow="0 16 48 0 #80000000">
          <StackPanel Spacing="18">
            <TextBlock Classes="muted small" HorizontalAlignment="Center" Text="Incoming call" />
            <c:Avatar Width="72" Height="72" HorizontalAlignment="Center"
                      DisplayName="{Binding Calls.ActivePeerName}"
                      Photo="{Binding Calls.ActivePeerPerson.Photo}" />
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Classes="h1" FontSize="28" HorizontalAlignment="Center"
                         Text="{Binding Calls.ActivePeerName}" />
              <TextBlock Classes="muted" HorizontalAlignment="Center"
                         Text="Answer to join voice and video in MeetJoe." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button Classes="danger" MinWidth="120" Content="Decline" Command="{Binding Calls.DeclineCommand}" />
              <Button Classes="primary" MinWidth="120" Content="Answer" Command="{Binding Calls.AnswerCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Panel>
  </Grid>
</UserControl>
