<Project Sdk="Microsoft.NET.Sdk">
  <!-- Thin Avalonia iOS host. UI lives in MeetJoe.App (M0 spike). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ProvisioningType>Automatic</ProvisioningType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.joesolutions.meetjoe</ApplicationId>
    <ApplicationTitle>MeetJoe</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RootNamespace>MeetJoe.iOS</RootNamespace>
    <AssemblyName>MeetJoe</AssemblyName>
    <!-- Xcode 26.6 vs workload “requires 26.0” major.minor check; allow newer Xcode locally. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeetJoe.App\MeetJoe.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>
</Project>
